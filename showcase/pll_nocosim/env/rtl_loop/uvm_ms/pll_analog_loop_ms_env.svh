//======================================================================
// pll_analog_loop_ms driver, monitor, agent, env.
//
// THE FULL TOPOLOGY, and in this flow it is warranted. The co-simulated
// system environment has a monitor, an agent and a scoreboard and no
// driver or sequence, because the testbench it wraps brings its own
// stimulus. Here there is no such testbench: the stimulus is the
// reference clock and this environment generates it, so there is
// something for a sequence, a sequencer and a driver to do.
//
// Neither the driver nor the monitor holds a hierarchical path into the
// design. Both go through the MS proxy, whose concrete half lives in
// top and is handed over by uvm_config_db.
//
// AUTO-GENERATED by spice2rnm (Veylon Systems).  Edits will be overwritten.
//======================================================================
class pll_analog_loop_ms_driver extends uvm_driver #(pll_analog_loop_ms_item);
  `uvm_component_utils(pll_analog_loop_ms_driver)

  pll_analog_loop_ms_proxy proxy;

  function new(string name, uvm_component parent);
    super.new(name, parent);
  endfunction

  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    if (!uvm_config_db #(pll_analog_loop_ms_proxy)::get(this, "", "proxy", proxy))
      `uvm_fatal("NOPROXY", "no MS proxy was handed to the driver")
  endfunction

  task run_phase(uvm_phase phase);
    pll_analog_loop_ms_item it;
    forever begin
      seq_item_port.get_next_item(it);
      proxy.push_ref_hz(it.ref_hz);
      proxy.run_window(it.settle_s, it.window_s, it.label);
      seq_item_port.item_done();
    end
  endtask
endclass : pll_analog_loop_ms_driver


class pll_analog_loop_ms_monitor extends uvm_monitor;
  `uvm_component_utils(pll_analog_loop_ms_monitor)

  uvm_analysis_port #(pll_analog_loop_ms_result) ap;
  pll_analog_loop_ms_proxy proxy;

  function new(string name, uvm_component parent);
    super.new(name, parent);
    ap = new("ap", this);
  endfunction

  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    if (!uvm_config_db #(pll_analog_loop_ms_proxy)::get(this, "", "proxy", proxy))
      `uvm_fatal("NOPROXY", "no MS proxy was handed to the monitor")
  endfunction

  task run_phase(uvm_phase phase);
    pll_analog_loop_ms_result r;
    forever begin
      // The window is opened and closed by whoever owns the counters, so
      // a half-finished one is never published.
      proxy.wait_window_done();
      r = pll_analog_loop_ms_result::type_id::create("r");
      r.label      = proxy.pull_label();
      r.ref_hz     = proxy.pull_ref_hz();
      r.rate_hz    = proxy.pull_rate_hz();
      r.edges      = proxy.pull_edges();
      r.ctrl_lo    = proxy.pull_ctrl_lo();
      r.ctrl_hi    = proxy.pull_ctrl_hi();
      r.ctrl_end   = proxy.pull_ctrl_end();
      r.all_finite = proxy.pull_all_finite();
      ap.write(r);
    end
  endtask
endclass : pll_analog_loop_ms_monitor


class pll_analog_loop_ms_agent extends uvm_agent;
  `uvm_component_utils(pll_analog_loop_ms_agent)

  pll_analog_loop_ms_driver                       driver;
  pll_analog_loop_ms_monitor                      monitor;
  uvm_sequencer #(pll_analog_loop_ms_item)        sequencer;

  function new(string name, uvm_component parent);
    super.new(name, parent);
  endfunction

  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    monitor = pll_analog_loop_ms_monitor::type_id::create("monitor", this);
    if (get_is_active() == UVM_ACTIVE) begin
      driver    = pll_analog_loop_ms_driver::type_id::create("driver", this);
      sequencer = uvm_sequencer #(pll_analog_loop_ms_item)::type_id::create(
                    "sequencer", this);
    end
  endfunction

  function void connect_phase(uvm_phase phase);
    super.connect_phase(phase);
    if (get_is_active() == UVM_ACTIVE)
      driver.seq_item_port.connect(sequencer.seq_item_export);
  endfunction
endclass : pll_analog_loop_ms_agent


class pll_analog_loop_ms_env extends uvm_env;
  `uvm_component_utils(pll_analog_loop_ms_env)

  pll_analog_loop_ms_agent      agent;
  pll_analog_loop_ms_scoreboard sb;

  function new(string name, uvm_component parent);
    super.new(name, parent);
  endfunction

  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    agent = pll_analog_loop_ms_agent::type_id::create("agent", this);
    sb    = pll_analog_loop_ms_scoreboard::type_id::create("sb", this);
  endfunction

  function void connect_phase(uvm_phase phase);
    super.connect_phase(phase);
    agent.monitor.ap.connect(sb.sb_imp);
  endfunction
endclass : pll_analog_loop_ms_env
