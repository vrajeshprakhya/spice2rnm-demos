//======================================================================
// pll_analog_sysms_scoreboard
//
// FOUR CHECKS, and they are not of equal standing. Two come from the
// specification and two from measurements this run made before the
// environment existed, and the report says which is which -- a reader
// who cannot tell them apart cannot tell what a pass is worth.
//
//   SPEC   the divider output reaches the reference within TOL_FRAC
//   SPEC   the control voltage sits inside its declared window
//   MEAS   the control voltage sits where the MEASURED tuning curve
//          puts that frequency. A loop can reach the right rate at the
//          wrong control voltage -- through a mis-signed pump, a
//          mis-fitted Kvco, a divider off by a factor the reference
//          happens to absorb -- and an edge count cannot see it. The
//          tuning curve was measured point by point in ngspice and is
//          inverted here at whatever frequency the item asked for.
//   MEAS   every analog boundary value stayed finite
//
// WHAT A PASS HERE IS NOT. There are no transistors in this
// environment. A loop that settles somewhere plausible and wrong --
// right rate, inside the window, consistent with the tuning curve --
// passes. Only a co-simulation against the real devices can catch that,
// and it needs a testbench spanning both halves, which this flow does
// not have.
//
// AUTO-GENERATED by spice2rnm (Veylon Systems).  Edits will be overwritten.
//======================================================================
class pll_analog_sysms_scoreboard extends uvm_scoreboard;

  `uvm_component_utils(pll_analog_sysms_scoreboard)

  uvm_analysis_imp #(pll_analog_sysms_result, pll_analog_sysms_scoreboard) sb_imp;

  int  rate_checks = 0,  rate_fail = 0;
  int  band_checks = 0,  band_fail = 0;
  int  tune_checks = 0,  tune_fail = 0;
  int  fin_checks  = 0,  fin_fail  = 0;
  real worst_rate_pct = 0.0;
  real worst_tune_mv  = 0.0;

  function new(string name, uvm_component parent);
    super.new(name, parent);
    sb_imp = new("sb_imp", this);
  endfunction

  // The measured tuning curve, as it came out of ngspice.
  localparam int TUNE_N = 15;
  function automatic real tune_v(input int idx);
    case (idx)
      0: tune_v = 0.495;
      1: tune_v = 0.78375;
      2: tune_v = 1.0725;
      3: tune_v = 1.36125;
      4: tune_v = 1.65;
      5: tune_v = 1.75;
      6: tune_v = 1.85;
      7: tune_v = 1.93875;
      8: tune_v = 1.95;
      9: tune_v = 2.05;
      10: tune_v = 2.2275;
      11: tune_v = 2.51625;
      12: tune_v = 2.660625;
      13: tune_v = 2.7328125;
      14: tune_v = 2.805;
      default: tune_v = 2.805;
    endcase
  endfunction
  function automatic real tune_f(input int idx);
    case (idx)
      0: tune_f = 804472819;
      1: tune_f = 735322257;
      2: tune_f = 663445965;
      3: tune_f = 580386264;
      4: tune_f = 477403257;
      5: tune_f = 438729202;
      6: tune_f = 399861721;
      7: tune_f = 365868945;
      8: tune_f = 361611464;
      9: tune_f = 324148009;
      10: tune_f = 257011965;
      11: tune_f = 136625165;
      12: tune_f = 74162781.7;
      13: tune_f = 42408825.9;
      14: tune_f = 16739484.5;
      default: tune_f = 16739484.5;
    endcase
  endfunction

  // The control voltage the MEASUREMENT puts `f` at. Linear between the
  // two measured points bracketing it; -1 when f is outside the range
  // the circuit was measured over, because extrapolating a tuning curve
  // to invent a golden would defeat the point of having measured one.
  function automatic real ctrl_for_freq(input real f);
    real v0, v1, f0, f1, lo, hi;
    ctrl_for_freq = -1.0;
    for (int i = 0; i < TUNE_N - 1; i++) begin
      v0 = tune_v(i);   v1 = tune_v(i + 1);
      f0 = tune_f(i);   f1 = tune_f(i + 1);
      lo = (f0 <= f1) ? f0 : f1;
      hi = (f0 <= f1) ? f1 : f0;
      if (f >= lo && f <= hi) begin
        ctrl_for_freq = (f1 == f0) ? v0 : v0 + (v1 - v0) * (f - f0) / (f1 - f0);
        return;
      end
    end
  endfunction

  function void write(pll_analog_sysms_result r);
    real want_hz, err, v_want, v_lo, v_hi, dv;

    want_hz = r.ref_hz;
    rate_checks++;
    err = (want_hz == 0.0) ? 1.0 : (r.rate_hz - want_hz) / want_hz;
    if (err * 100.0 > worst_rate_pct)  worst_rate_pct = err * 100.0;
    if (-err * 100.0 > worst_rate_pct) worst_rate_pct = -err * 100.0;
    if (err > TOL_FRAC || err < -TOL_FRAC) begin
      rate_fail++;
      `uvm_error("SYS_RATE", $sformatf(
        "%s: divider output %0.6f MHz against the %0.6f MHz reference it follows (%+0.4f%%, tolerance %0.3f%%) [SPEC]",
        r.label, r.rate_hz / 1.0e6, want_hz / 1.0e6, err * 100.0, TOL_FRAC * 100.0))
    end

    band_checks++;
    if (BAND_STATED) begin
      if (r.ctrl_end < BAND_LO || r.ctrl_end > BAND_HI) begin
        band_fail++;
        `uvm_error("SYS_BAND", $sformatf(
          "%s: control settled at %0.4f V, outside the %0.4f..%0.4f V the specification states [SPEC]",
          r.label, r.ctrl_end, BAND_LO, BAND_HI))
      end
    end

    // The measured half. The frequency the OSCILLATOR is running at is
    // the divider output times N, not the divider output.
    v_want = ctrl_for_freq(want_hz * NDIV);
    v_lo   = ctrl_for_freq(want_hz * NDIV * (1.0 + TOL_FRAC));
    v_hi   = ctrl_for_freq(want_hz * NDIV * (1.0 - TOL_FRAC));
    if (v_lo > v_hi) begin real t; t = v_lo; v_lo = v_hi; v_hi = t; end
    if (v_want < 0.0 || v_lo < 0.0 || v_hi < 0.0) begin
      `uvm_info("SYS_TUNE", $sformatf(
        "%s: %0.6g MHz is outside the range the tuning curve was measured over, so this window has no measured golden for its control voltage",
        r.label, want_hz * NDIV / 1.0e6), UVM_LOW)
    end else begin
      tune_checks++;
      dv = r.ctrl_end - v_want;
      if (dv < 0.0) dv = -dv;
      if (dv * 1000.0 > worst_tune_mv) worst_tune_mv = dv * 1000.0;
      if (r.ctrl_end < v_lo || r.ctrl_end > v_hi) begin
        tune_fail++;
        `uvm_error("SYS_TUNE", $sformatf(
          "%s: control settled at %0.4f V, but the MEASURED tuning curve puts %0.4f MHz at %0.4f V (%0.4f..%0.4f V for +/-%0.3f%%) -- the loop reached its rate by some path the oscillator's own measurement does not support [MEASURED]",
          r.label, r.ctrl_end, want_hz * NDIV / 1.0e6, v_want, v_lo, v_hi,
          TOL_FRAC * 100.0))
      end
    end

    fin_checks++;
    if (!r.all_finite) begin
      fin_fail++;
      `uvm_error("SYS_FINITE", $sformatf(
        "%s: an analog boundary value was not finite [MEASURED]", r.label))
    end

    `uvm_info("SYS_WINDOW", $sformatf(
      "%-9s ref %0.6f MHz -> div %0.6f MHz (%+0.4f%%, %0d edges), control %0.4f..%0.4f V ending %0.4f V%s",
      r.label, want_hz / 1.0e6, r.rate_hz / 1.0e6, err * 100.0, r.edges,
      r.ctrl_lo, r.ctrl_hi, r.ctrl_end,
      (v_want >= 0.0) ? $sformatf(", measurement says %0.4f V", v_want) : ""),
      UVM_LOW)
  endfunction

  function void report_phase(uvm_phase phase);
    `uvm_info("SB_SUMMARY", $sformatf(
      "rate checks=%0d failed=%0d | worst %+0.4f%% against %0.3f%% [SPEC]",
      rate_checks, rate_fail, worst_rate_pct, TOL_FRAC * 100.0), UVM_LOW)
    if (BAND_STATED)
      `uvm_info("SB_SUMMARY", $sformatf(
        "control-window checks=%0d failed=%0d | the specification states %0.4f..%0.4f V [SPEC]",
        band_checks, band_fail, BAND_LO, BAND_HI), UVM_LOW)
    else
      `uvm_info("SB_SUMMARY",
        "control-window checks=0 (the specification states no window)", UVM_LOW)
    if (tune_checks > 0)
      `uvm_info("SB_SUMMARY", $sformatf(
        "tuning-curve checks=%0d failed=%0d | worst %0.2f mV from where the MEASURED curve puts that frequency [MEASURED]",
        tune_checks, tune_fail, worst_tune_mv), UVM_LOW)
    else
      `uvm_info("SB_SUMMARY",
        "tuning-curve checks=0 -- no window asked for a frequency inside the measured range", UVM_LOW)
    `uvm_info("SB_SUMMARY", $sformatf(
      "finite checks=%0d failed=%0d [MEASURED]", fin_checks, fin_fail), UVM_LOW)
    `uvm_info("SB_SUMMARY",
      "no transistors were simulated here: a loop settling somewhere plausible and wrong passes all of the above",
      UVM_LOW)
  endfunction

endclass : pll_analog_sysms_scoreboard
