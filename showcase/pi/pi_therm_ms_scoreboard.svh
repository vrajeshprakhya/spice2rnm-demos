//======================================================================
// pi_therm_ms_scoreboard -- phase per code against ngspice measurement.
//
// Measures the output's falling crossings of its own midpoint, reduces
// them modulo the period, and compares the mean against the golden. Both
// sides have the same reference removed, because a delay line reproduces
// RELATIVE phase: it cannot advance a signal, so an overall offset is
// not a property the model claims.
//
// AUTO-GENERATED by spice2rnm (Veylon Systems).  Edits will be overwritten.
//======================================================================
class pi_therm_ms_scoreboard extends uvm_component;
  `uvm_component_utils(pi_therm_ms_scoreboard)

  int  n_checked;
  int  n_failed;
  real worst_err;
  real first_delay;
  bit  have_first;

  function new(string name, uvm_component parent);
    super.new(name, parent);
    n_checked = 0; n_failed = 0; worst_err = 0.0; have_first = 1'b0;
  endfunction

  // Called once per code with the phase the monitor measured.
  function void check_code(input int c, input real meas_phase);
    real want, got, err;
    want = golden_phase(c) - PHASE_BASE;
    got  = meas_phase;
    if (!have_first) begin
      // Anchor both sides on the first code actually measured, which is
      // what makes this a relative-phase check rather than an absolute one.
      first_delay = got - want;
      have_first  = 1'b1;
    end
    got = got - first_delay;
    err = (got > want) ? (got - want) : (want - got);
    n_checked++;
    if (err > worst_err) worst_err = err;
    if (err > TOL_S) begin
      n_failed++;
      `uvm_error("PHASE_CHECK",
                 $sformatf("FAIL code %0d: ngspice %0.4f ps, model %0.4f ps, err %0.4f ps > tol %0.4f ps",
                           c, want*1.0e12, got*1.0e12, err*1.0e12, TOL_S*1.0e12))
    end else begin
      `uvm_info("PHASE_CHECK",
                $sformatf("code %0d: ngspice %0.4f ps, model %0.4f ps, err %0.4f ps",
                          c, want*1.0e12, got*1.0e12, err*1.0e12), UVM_HIGH)
    end
  endfunction

  function void report_phase();
    if (n_checked == 0)
      `uvm_error("SB_SUMMARY",
                 "no phase checks ran -- the monitor never reached the scoreboard")
    `uvm_info("SB_SUMMARY",
              $sformatf("phase checks=%0d failed=%0d | worst %0.4f ps (tol %0.4f ps)",
                        n_checked, n_failed, worst_err*1.0e12, TOL_S*1.0e12),
              UVM_LOW)
  endfunction
endclass
