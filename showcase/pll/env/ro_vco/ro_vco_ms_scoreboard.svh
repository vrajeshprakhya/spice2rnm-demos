//======================================================================
// ro_vco_ms_scoreboard -- measured rate against ngspice, by point kind.
//
// Breakpoints and held-out voltages are tallied SEPARATELY because a miss
// in each means something different. At a breakpoint the model is
// reproducing a number it was handed, so a failure there means the emitted
// table or its interpolation is wrong. At a held-out voltage the model is
// interpolating, so a failure means the table is too coarse for the
// curvature -- a sampling decision, not a defect. Collapsing them into one
// number would hide which of those happened.
//
// Error is expressed as a fraction of PERIOD rather than of frequency: the
// model schedules edges by half period, so period is the quantity that
// reaches the waveform, and at the slow end of a wide tuning range the two
// differ enough to matter.
//
// AUTO-GENERATED by spice2rnm (Veylon Systems).  Edits will be overwritten.
//======================================================================
class ro_vco_ms_scoreboard extends uvm_component;
  `uvm_component_utils(ro_vco_ms_scoreboard)

  int  n_bp, n_bp_fail;
  int  n_ho, n_ho_fail;
  int  n_ho_out;            // held-out points outside the measured band
  real worst_out, worst_out_v;
  real worst_bp, worst_ho;
  real worst_ho_v;

  function new(string name, uvm_component parent);
    super.new(name, parent);
    n_bp = 0; n_bp_fail = 0; n_ho = 0; n_ho_fail = 0;
    worst_bp = 0.0; worst_ho = 0.0; worst_ho_v = 0.0;
  endfunction

  function void check_point(input real v, input real want_f,
                            input real got_f, input bit held_out);
    real want_t, got_t, frac;
    if (want_f <= 0.0 || got_f <= 0.0) begin
      `uvm_error("VCO_CHECK",
                 $sformatf("non-positive frequency at %0.4f V (golden %0.6g, model %0.6g)",
                           v, want_f, got_f))
      return;
    end
    want_t = 1.0 / want_f;
    got_t  = 1.0 / got_f;
    frac   = (got_t > want_t) ? (got_t - want_t) / want_t
                              : (want_t - got_t) / want_t;
    if (held_out) begin
      bit in_band;
      in_band = (!HAS_BAND) || (v >= BAND_LO && v <= BAND_HI);
      n_ho++;
      if (!in_band) begin
        // Outside the band the loop drives. Reported, never failed -- the
        // same position the pipeline takes, and for the same reason: this
        // is a fact about how far the sweep went, not about the model.
        n_ho_out++;
        if (frac > worst_out) begin worst_out = frac; worst_out_v = v; end
        `uvm_info("VCO_CHECK",
                  $sformatf("outside the measured operating band %0.4f..%0.4f V: %0.4f V is %0.3f%% of period (ngspice %0.6g Hz, model %0.6g Hz). Reported, not failed.",
                            BAND_LO, BAND_HI, v, frac*100.0, want_f, got_f),
                  UVM_LOW)
      end else begin
        if (frac > worst_ho) begin worst_ho = frac; worst_ho_v = v; end
        if (frac > TOL_FRAC) begin
          n_ho_fail++;
          `uvm_error("VCO_CHECK",
                     $sformatf("FAIL held-out %0.4f V: ngspice %0.6g Hz, model %0.6g Hz, %0.3f%% of period > tol %0.3f%%",
                               v, want_f, got_f, frac*100.0, TOL_FRAC*100.0))
        end
      end
    end else begin
      n_bp++;
      if (frac > worst_bp) worst_bp = frac;
      if (frac > TOL_FRAC) begin
        n_bp_fail++;
        `uvm_error("VCO_CHECK",
                   $sformatf("FAIL breakpoint %0.4f V: ngspice %0.6g Hz, model %0.6g Hz, %0.3f%% of period -- the emitted table disagrees with the data it was built from",
                             v, want_f, got_f, frac*100.0))
      end
    end
  endfunction

  function void report_vco();
    // A run that checked nothing is a failure, not a pass. The phase
    // environment learned this the hard way: an unreached monitor reported
    // zero checks and read as clean.
    if (n_bp + n_ho == 0)
      `uvm_error("SB_SUMMARY",
                 "no VCO checks ran -- the driver never reached the scoreboard")
    if (n_ho == 0 && n_bp > 0)
      `uvm_warning("SB_SUMMARY",
                   "only breakpoints were checked; a table is exact at its own breakpoints, so this run demonstrates transcription, not accuracy")
    `uvm_info("SB_SUMMARY",
              $sformatf("vco breakpoint checks=%0d failed=%0d | worst %0.3f%% of period",
                        n_bp, n_bp_fail, worst_bp*100.0), UVM_LOW)
    `uvm_info("SB_SUMMARY",
              $sformatf("vco held-out checks=%0d failed=%0d | worst %0.3f%% at %0.4f V (tol %0.3f%%)%s",
                        n_ho - n_ho_out, n_ho_fail, worst_ho*100.0, worst_ho_v,
                        TOL_FRAC*100.0,
                        HAS_BAND ? $sformatf(", judged inside the measured band %0.4f..%0.4f V",
                                             BAND_LO, BAND_HI) : ""),
              UVM_LOW)
    // The wider figure is printed rather than dropped: a reader should see
    // where the curve was not followed, and that it was not judged there.
    if (n_ho_out > 0)
      `uvm_info("SB_SUMMARY",
                $sformatf("vco outside the band: %0d point(s) reported, worst %0.3f%% at %0.4f V -- where the loop does not go",
                          n_ho_out, worst_out*100.0, worst_out_v), UVM_LOW)
    if (HAS_BAND && n_ho == n_ho_out && n_ho > 0)
      `uvm_warning("SB_SUMMARY",
                   "every held-out point fell outside the measured operating band, so nothing inside it was scored")
  endfunction
endclass
