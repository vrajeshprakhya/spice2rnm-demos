# Run outputs live under ~/s2r_runs, not here -- but keep stray artifacts out
# if anyone ever points a demo at its own directory.
*.vcd
*.log
__pycache__/
*.pyc

# pdflatex's scratch files. The .pdf and the .tex are tracked; these are
# rebuilt on every pass and otherwise show the tree as dirty after a
# build. (.log is already covered above.)
whitepaper*/*.aux
whitepaper*/*.out
whitepaper*/*.toc

# The curated equivalence evidence is the exception: these logs are the
# record of what actually ran, small by construction (refresh.sh copies
# only logs and manifests the traces), and the whitepaper points readers
# here for them. Without this the folder publishes a manifest of evidence
# and none of the evidence.
!showcase/*/equivalence/**/*.log

# The UVM-MS run logs are the second exception, for the same reason as
# the first: the docs quote figures from them (docs/jitter.md's boundary
# jitter), and a figure a reader cannot check is worse than no figure.
# They are small -- one environment's console output, not a trace -- and
# showcase/run_uvm_ms.sh regenerates them.
!showcase/uvm_ms_runs/*/*.log

# Simulator coverage written by running a published environment. A
# reader who runs one should not then see their tree as dirty.
xezim_cov.json
